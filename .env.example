# API URL configuration for Restaurant Portal
#
# 1. Local Development:
# Copy this file to .env.local (or leave unset to use http://localhost:3000 default)
VITE_API_URL=http://localhost:3000

# 2. Production (Vercel Frontend):
# In Vercel Project Settings -> Environment Variables, add:
# Key: VITE_API_URL
# Value: https://<your-render-service-name>.onrender.com
